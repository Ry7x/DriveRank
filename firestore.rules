
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Only the founder account may carry isAdmin (keep in sync with ADMIN_EMAIL in src/app/page.tsx).
    function isAdminAccount() {
      return request.auth.token.email == 'admin@gmail.com';
    }

    // Blocks users from granting themselves the FOUNDER badge on any document.
    function noFakeAdmin(data) {
      return data.get('isAdmin', false) != true || isAdminAccount();
    }

    // Profile writes may not grant isAdmin / isPremium; existing values are preserved.
    function validProfileCreate() {
      return noFakeAdmin(request.resource.data)
        && (request.resource.data.get('isPremium', false) != true || isAdminAccount());
    }
    function validProfileUpdate() {
      return (request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
              || noFakeAdmin(request.resource.data))
        && (request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false)
            || isAdminAccount());
    }

    // Rekordet publike të garave (Ranking)
    match /public_runs/{runId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && noFakeAdmin(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && noFakeAdmin(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    // Përmbledhje të lehta të garave për ranking (pa telemetri / GPS path).
    // Same id as the matching public_runs doc. Field list mirrors SUMMARY_FIELDS in src/lib/runs.ts.
    function isSlimSummary(data) {
      return data.keys().hasOnly([
        'userId', 'username', 'community', 'profileIcon', 'isAdmin', 'city',
        'carBrand', 'carModel', 'runType', 'dragTime', 'peakSpeedKmH', 'createdAt'
      ]);
    }

    match /run_summaries/{runId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.userId
        && isSlimSummary(request.resource.data)
        && noFakeAdmin(request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && isSlimSummary(request.resource.data)
        && noFakeAdmin(request.resource.data);
      allow delete: if signedIn() && request.auth.uid == resource.data.userId;
    }

    // Profilet e përdoruesve dhe garat e tyre
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && validProfileCreate();
      allow update: if isOwner(userId) && validProfileUpdate();
      allow delete: if isOwner(userId);

      match /runs/{runId} {
        allow get, list: if signedIn();
        allow create, update: if isOwner(userId) && noFakeAdmin(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Raportet e komunitetit për radarë
    match /radar_reports/{reportId} {
      allow get, list: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
    }
    
    // Versioni i rregullave: 22.0 - run_summaries për ranking; leximi vetëm për përdorues të kyçur
  }
}
